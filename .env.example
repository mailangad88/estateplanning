# Two-letter state codes the firm is licensed in and accepts leads from, comma separated.
# Placeholder until the launch state is confirmed.
SERVED_STATES=XX

# Where new leads are forwarded (a Zapier, Make or n8n webhook that creates the lead in the CRM).
# Leave empty in development: leads are accepted and only a non-identifying summary is logged.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Lawyer portal backend ----
# Signs portal session cookies. Required in production, 32+ characters.
SESSION_SECRET=
# Development-only "sign in as" picker at /portal. Ignored in production.
ENABLE_DEV_LOGIN=true
# Also hand website leads to the portal backend (off until the Postgres store is configured).
PORTAL_INGEST_LEADS=false
# Seed a demo firm, attorneys and leads into the in-memory development store.
PORTAL_SEED_DEMO=true
# Allows exports from the portal. Off by default.
PORTAL_EXPORT_ENABLED=false
# Bearer secret for POST /api/cron/sweep (offer timeouts, reminders, nurture, CRM sync).
CRON_SECRET=

# CRM sync: lawmatics (default) | hubspot | mock. A missing token falls back to the mock outside production.
CRM_PROVIDER=lawmatics
LAWMATICS_API_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=

# E-sign: docusign | dropboxsign | mock. Production refuses the mock.
ESIGN_PROVIDER=mock
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_BASE_URI=
DOCUSIGN_HMAC_KEY=
DROPBOXSIGN_API_KEY=
DROPBOXSIGN_TEST_MODE=true

# Postgres store (db/schema.sql). When set, the portal uses Postgres with row-level security.
DATABASE_URL=
# Secret (32+ characters) that encrypts authenticator secrets at rest. Required in production.
MFA_ENCRYPTION_KEY=
# Public base URL used in sign-in links, client invites and alert emails.
APP_URL=http://localhost:3000
# Sign-in email delivery. Leave empty in development (links are printed to the console).
# Production refuses to start sign-in until a transport is implemented and named here.
EMAIL_TRANSPORT=
# Allows the console notifier in production for a staging demo. Off by default.
NOTIFY_ALLOW_CONSOLE=false

# Content publish gate: when "true", library pages not marked `review: approved` are noindexed and left
# out of the sitemap, llms.txt and feed. Turn on in production once the attorney starts approving pages.
REQUIRE_ATTORNEY_REVIEW=
# IndexNow key (32 hex characters). Served at /indexnow-key.txt; the same value goes in the INDEXNOW_KEY
# GitHub secret so .github/workflows/indexnow.yml can ping search engines after content merges.
INDEXNOW_KEY=
# Matter types the firm takes, comma separated (new_plan, update_plan, administration, elder_law,
# special_needs, business_succession). Leads outside the list exit politely. Empty = take every type.
PORTAL_PRACTICE_MATTERS=

# ---- Staging ----
# Set to "staging" on a staging Vercel project: placeholders don't block the build, every page is
# noindexed, robots.txt disallows all crawlers, a staging banner shows, and form submissions are
# NOT forwarded to CRM_WEBHOOK_URL. Never set this on the real production project.
SITE_ENV=
# Allow staging submissions to reach the CRM webhook (for testing the CRM flow only).
STAGING_ALLOW_CRM=false

# ---- Consult booking (Cal.com) ----
# Your Cal.com "username/event-slug". Replaces the iframe scheduler with the Cal.com inline embed.
NEXT_PUBLIC_CALCOM_LINK=
# Secret set on the Cal.com webhook pointing at /api/webhooks/calcom. Without it the webhook returns 401.
CALCOM_WEBHOOK_SECRET=
