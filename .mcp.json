{
  "mcpServers": {
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server@3.1.3"],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN:-}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD:-${DATAFORSEO_PSWD:-}}"
      }
    },
    "excalidraw": {
      "command": "npx",
      "args": ["-y", "mcp-excalidraw-server@2.1.2"],
      "env": {
        "EXPRESS_SERVER_URL": "http://127.0.0.1:3100",
        "ENABLE_CANVAS_SYNC": "true",
        "EXCALIDRAW_EXPORT_DIR": "docs/diagrams"
      }
    }
  }
}
